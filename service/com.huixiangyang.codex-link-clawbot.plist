<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.huixiangyang.codex-link-clawbot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/codex-link-clawbot</string>
        <string>start</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- 应用自行写入用户状态目录 logs/service.log，不再创建 /tmp 固定日志。 -->
</dict>
</plist>
